{
  "name": "eslint-plugin-ng-material",
  "version": "1.0.0",
  "description": "ESLint plugin that enforces the camelCase Angular Material button selectors (matButton, matIconButton, matFab, matMiniFab) instead of mat-button, mat-raised-button and friends",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "lib"
  ],
  "keywords": [
    "eslint",
    "eslint-plugin",
    "angular",
    "angular-material",
    "material",
    "mat-button",
    "mat-button-directive",
    "mat-fab",
    "button",
    "camelcase",
    "camel-case",
    "naming",
    "naming-convention",
    "lint",
    "linting",
    "enforce",
    "style",
    "styleguide"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sertacozmen1/eslint-plugin-ng-material-camelcase.git"
  },
  "bugs": {
    "url": "https://github.com/sertacozmen1/eslint-plugin-ng-material-camelcase/issues"
  },
  "homepage": "https://github.com/sertacozmen1/eslint-plugin-ng-material-camelcase#readme",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "peerDependencies": {
    "@angular-eslint/template-parser": "^21.3.0 || ^22.0.0",
    "eslint": "^10.0.0"
  },
  "devDependencies": {
    "@angular-eslint/template-parser": "^22.8.0",
    "eslint": "^10.15.0"
  },
  "scripts": {
    "check": "npm pack --dry-run",
    "test": "node --test",
    "prepublishOnly": "npm run check"
  }
}
